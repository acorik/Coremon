# Cabeceras para Cloudflare Pages (y Netlify): el juego siempre en su última
# versión; los iconos e imágenes pueden quedarse en caché.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
/icons/*
  Cache-Control: public, max-age=604800
