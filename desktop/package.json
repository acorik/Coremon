{
  "name": "coremon",
  "productName": "Coremon",
  "version": "1.0.0",
  "description": "Coremon: Edición Corazonistas Vitoria. Un juego de acorik.",
  "author": "acorik",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-game": "node prepare.js",
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.acorik.coremon",
    "productName": "Coremon",
    "copyright": "© acorik",
    "files": [
      "main.js",
      "game/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "game/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Coremon-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Coremon-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "game/icons/icon-512.png",
      "artifactName": "Coremon-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "game/icons/icon-512.png",
      "artifactName": "Coremon-${version}-mac.${ext}"
    },
    "publish": null
  },
  "repository": "https://github.com/acorik/Coremon"
}
